~/.zshrc — chezmoi-managed. Was generated by home-manager; this is the same
content with nix-store paths replaced by brew/mise paths.
# {{ .chezmoi.sourceFile }} — managed by chezmoi; edit in the dotfiles repo.
typeset -U path cdpath fpath manpath

# ---- powerlevel10k instant prompt (must stay at top) ----
if [[ -r "$HOME/.cache/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "$HOME/.cache/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ---- Homebrew (arm64 or Intel prefix) ----
eval "($( /opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv 2>/dev/null))"

# ---- antidote plugins (from ~/.zsh_plugins.txt) ----
source "${HOMEBREW_PREFIX:-/opt/homebrew}/share/antidote/antidote.zsh"
antidote load

autoload -U compinit && compinit

# ---- history (was home-manager's zsh module defaults) ----
HISTSIZE="10000"
SAVEHIST="10000"
HISTFILE="$HOME/.zsh_history"
setopt HIST_FCNTL_LOCK HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY
setopt NO_APPEND_HISTORY NO_EXTENDED_HISTORY NO_HIST_EXPIRE_DUPS_FIRST
setopt NO_HIST_FIND_NO_DUPS NO_HIST_IGNORE_ALL_DUPS NO_HIST_SAVE_NO_DUPS

# ---- p10k config ----
[[ -f "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"

# ---- aliases & env (was zsh.initContent) ----
unsetopt nomatch
alias gs='git status'
alias gc='git commit'
alias gp='git pull'
alias ll='ls -lah --color=always'
alias mkdir='mkdir -p'

export NODE_EXTRA_CA_CERTS="$HOME/.step/certs/root_ca.crt"  # was hm sessionVariables
export DOTNET_ROOT="$HOME/.local/share/mise/dotnet-root"
export PATH="$PATH:$HOME/.dotnet/tools:$DOTNET_ROOT"
export LIBRARY_PATH="$LIBRARY_PATH:$(brew --prefix)/lib:$(brew --prefix)/opt/libiconv/lib"

# ---- mise ----
eval "$(mise activate zsh)"

# oMLX: CLI shim path begin
case ":$PATH:" in
  *":$HOME/.omlx/bin:"*) ;;
  *) export PATH="$HOME/.omlx/bin:$PATH" ;;
esac
# oMLX: CLI shim path end
